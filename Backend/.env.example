# =========================================================
# DIGITAL ALIFE - BACKEND ENVIRONMENT TEMPLATE
# =========================================================
# Local development is active below.
# For hosting, comment the LOCAL DEPLOYMENT block and uncomment
# the PRODUCTION DEPLOYMENT block.

# =========================================================
# 1) DEPLOYMENT SETTINGS - LOCAL (ACTIVE)
# =========================================================
NODE_ENV=development
PORT=7000
PUBLIC_DEMO_HOST=http://localhost:7000
DEMO_MANAGER_URL=http://localhost:7000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:7000,http://127.0.0.1:5173,http://127.0.0.1:7000

# Social-post OAuth callbacks (local)
BACKEND_PUBLIC_URL=http://localhost:7000
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:7000/api/social-app/social/youtube/callback
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI=http://localhost:7000/api/social-app/social/google/callback

# =========================================================
# 2) DEPLOYMENT SETTINGS - PRODUCTION (UNCOMMENT ON HOST)
# =========================================================
# NODE_ENV=production
# PORT=7000
# PUBLIC_DEMO_HOST=https://your-domain.com
# DEMO_MANAGER_URL=https://your-domain.com
# FRONTEND_URL=https://your-domain.com
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# =========================================================
# 3) DATABASE
# =========================================================
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=test
MONGODB_DB=demo_manager

# =========================================================
# 4) ADMIN AUTHENTICATION AND PASSWORD RESET
# =========================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
DEMO_SESSION_SECRET=change-me-now
AUTH_JWT_SECRET=change-me-now
AUTH_JWT_TTL=1h
AUTH_COOKIE_NAME=access_token
AUTH_REFRESH_JWT_TTL=30d
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_MFA_COOKIE_NAME=mfa_challenge
AUTH_MFA_TTL=5m
TOTP_ISSUER=Digital Alife Admin
WEBAUTHN_RP_NAME=Digital Alife Admin
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
# For LAN/production, set WEBAUTHN_ORIGIN to the exact HTTPS site origin.
PASSKEY_COOKIE_NAME=passkey_challenge
COOKIE_SECRET=change-me-to-a-long-random-secret
PASSWORD_RESET_TTL_MS=900000
PASSWORD_RESET_DAILY_LIMIT=3

# Mongo backups (mongodump must be installed on the host)
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
SECURITY_ACTIVITY_RETENTION_DAYS=180

# =========================================================
# 5) EMAIL / SMTP
# =========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# =========================================================
# 6) DEMO MANAGER
# =========================================================
DEMO_BASE_PORT=9000
DEMO_MAX_PORTS=1000
DEMO_DURATION_MINUTES=60

# =========================================================
# 7) UPLOAD AND FILE SECURITY
# =========================================================
UPLOAD_SCAN_COMMAND=
# Maximum size of one project file/video/ZIP upload (500 MB).
UPLOAD_MAX_BYTES=524288000
SITE_ASSET_MAX_BYTES=10485760
ZIP_MAX_COMPRESSED_BYTES=52428800
ZIP_MAX_UNCOMPRESSED_BYTES=262144000
ZIP_MAX_FILES=5000
ZIP_MAX_DEPTH=20
ZIP_MAX_RATIO=100

# =========================================================
# 8) DOCKER DEMO RESOURCE LIMITS
# =========================================================
DEMO_MEMORY=512m
DEMO_CPUS=1
DEMO_PIDS_LIMIT=256
DEMO_DISABLE_NETWORK_EGRESS=false

# =========================================================
# 9) CLEANUP AND DISK SAFETY
# =========================================================
CLEANUP_INTERVAL_MS=30000
IMAGE_CLEANUP_INTERVAL_MS=21600000
IMAGE_RECENT_HOURS=24
DISK_MIN_FREE_BYTES=1073741824

# =========================================================
# 10) CLOUDINARY
# =========================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
