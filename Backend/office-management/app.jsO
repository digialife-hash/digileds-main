//   }

//   return [
//     ...new Set([
//       ...configuredOrigins,
//       "http://localhost:5173",
//       "http://localhost:5174",
//       "http://127.0.0.1:5173",
//       "http://127.0.0.1:5174",
//     ]),
//   ];
// };
const getAllowedOrigins = () => {
  const selfOrigin = `http://localhost:${process.env.PORT || 5000}`;
  const selfIpOrigin = `http://127.0.0.1:${process.env.PORT || 5000}`;
  const configuredOrigins = [
    process.env.FRONTEND_URL,
    ...(process.env.FRONTEND_URLS || "").split(","),
    selfOrigin,
    selfIpOrigin,
  ]
    .map(origin => origin?.trim().replace(/\/+$/, ""))
    .filter(Boolean);

  if (process.env.NODE_ENV === "production") {  
    return [...new Set(configuredOrigins)];
  }

  return [
    ...new Set([
      ...configuredOrigins,
      "http://localhost:5173",
      "http://localhost:5174",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5174",
    ]),
  ];
};

app.set("trust proxy", 1);
app.set("query parser", (queryString) =>
  mongoSanitize.sanitize(parseQueryString(queryString))
);

app.use(
  helmet({
    crossOriginResourcePolicy: { policy: "cross-origin" },
  })
);

app.use(
  cors({
    origin(origin, callback) {
      if (!origin || getAllowedOrigins().includes(origin)) {
        callback(null, true);
        return;
      }

      callback(new AppError("Request origin is not allowed", 403, "INVALID_REQUEST_ORIGIN"));
    },
    credentials: true,
  })
);

app.use((req, res, next) => {
  if (["GET", "HEAD", "OPTIONS"].includes(req.method)) {
    return next();
  }

  const allowedOrigins = getAllowedOrigins();
  const requestOrigin = req.get("origin");
  const hasAuthCookie = /(?:^|;\s*)(accessToken|refreshToken)=/.test(
    req.get("cookie") || ""
  );

  if (requestOrigin && !allowedOrigins.includes(requestOrigin)) {
    return next(
      new AppError(
        "Request origin is not allowed",
        403,
        "INVALID_REQUEST_ORIGIN"
      )
    );
  }

  if (process.env.NODE_ENV === "production" && !requestOrigin && hasAuthCookie) {
    return next(
      new AppError(
        "Request origin is required",
        403,
        "REQUEST_ORIGIN_REQUIRED"
      )
    );
  }

  return next();
});

app.use(
  rateLimit({
    windowMs: 15 * 60 * 1000,
    max: 300,
    skip: () => process.env.NODE_ENV === "development",
    standardHeaders: true,
    legacyHeaders: false,
    message: {
      success: false,
      message: "Too many requests. Please try again later.",
      data: null,
      error: {
        code: "TOO_MANY_REQUESTS",
      },
    },
  })
);

app.use(express.json({ limit: "10kb" }));
app.use(express.urlencoded({ extended: true, limit: "10kb" }));

// Expose uploaded files directory
const uploadsDir = path.join(process.cwd(), "uploads");
if (!fs.existsSync(uploadsDir)) {
  fs.mkdirSync(uploadsDir, { recursive: true });
}
app.use(
  "/uploads",
  (req, res, next) => {
    res.setHeader("Cross-Origin-Resource-Policy", "cross-origin");
    res.setHeader("Access-Control-Allow-Origin", "*");
    next();
  },
  express.static(uploadsDir)
);

app.use(cookieParser());
app.use((req, res, next) => {
  ["body", "params", "headers"].forEach((key) => {
    if (req[key]) mongoSanitize.sanitize(req[key]);
  });

  next();
});

const getRequiredEnvStatus = () => {
  const requiredEnv = ["MONGO_URI", "JWT_SECRET"];
  if (process.env.NODE_ENV === "production") {
    requiredEnv.push("JWT_REFRESH_SECRET");
  }

  return requiredEnv.filter((key) => !process.env[key]);
};

const healthHandler = (req, res) => {
  const missingEnv = getRequiredEnvStatus();

  res.status(200).json({
    success: true,
    status: missingEnv.length ? "degraded" : "ok",
    data: {
      database: mongoose.connection.readyState === 1 ? "connected" : "not_connected",
      missingEnv,
    },
    error: null,
  });
};

app.get("/health", healthHandler);
app.get("/api/health", healthHandler);

app.get("/favicon.ico", (req, res) => {
  const buildPath = getFrontendBuildPath();
  const faviconPath = buildPath ? path.join(buildPath, "favicon.svg") : null;

  if (faviconPath && fs.existsSync(faviconPath)) {
    return res.status(200).type("image/svg+xml").sendFile(faviconPath);
  }

  return res.status(204).end();
});

app.get("/api/dev/session", (req, res, next) => {
  if (process.env.NODE_ENV === "development" && process.env.ENABLE_DEV_AUTH_BYPASS === "true") {
    return res.status(200).json({
      authenticated: true,
      user: {
        _id: "000000000000000000000000",
        name: "Developer",
        role: process.env.DEV_LOGIN_ROLE || "super_admin",
      },
    });
  }
  return next();
});

